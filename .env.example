# Server Configuration
PORT=3001
HOST=127.0.0.1

# Local Ollama Inference Target
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_MODEL=gemma3:4b

# Storage Paths (optional). Defaults to a user folder that survives terminal restarts:
#   Windows: %LOCALAPPDATA%\LedgerLens
#   macOS/Linux: ~/.ledgerlens
# Relative paths are resolved from the repo root, not the terminal's current folder.
# DATA_DIR=./data
# DB_FILE=./data/ledgerlens.sqlite
